 "steps": [
  {
   "no": 1,
   "title": "Web delivery",
   "desc": "The static web app is served from S3 through CloudFront."
  },
  {
   "no": 2,
   "title": "Frame in",
   "desc": "The browser sends a small JPEG about twice a second with the access key. Lambda decodes it in memory."
  },
  {
   "no": 3,
   "title": "Key check",
   "desc": "The access key is verified against an SSM SecureString; requests fail closed."
  },
  {
   "no": 4,
   "title": "Session state",
   "desc": "Only aggregates and filter state (<=8KB) go to DynamoDB with a 24h TTL. Frames are discarded after the response."
  },
  {
   "no": 5,
   "title": "Agent LLM",
   "desc": "A rules agent decides first; Bedrock Claude is optional, time-boxed, and guardrailed with rule fallback."
  },
  {
   "no": 6,
   "title": "Telemetry",
   "desc": "Latency, decision counts and errors are emitted as EMF metrics. No image data is ever logged."
  }
 ]
}